{
  "compilerOptions": {
    "target": "ES2020",
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types", "./typings"],
    "module": "commonjs",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["lib/util/**/*.ts", "lib/shared/**/*.ts", "lib/shared/sudo/windows.ts"],
  "exclude": ["lib/shared/sudo/darwin.ts", "lib/shared/sudo/linux.ts", "lib/shared/sudo/*.js", "lib/shared/typings"]
}
